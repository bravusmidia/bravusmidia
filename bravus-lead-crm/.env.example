# Copie para .env.local e preencha. NUNCA coloque segredos reais no GitHub.
# Dados PÚBLICOS do projeto Supabase (Project Settings → API). A anon key é pública por design; a proteção é o RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# --- Secrets das Edge Functions (configure com: supabase secrets set NOME=valor) ---
# WHATSAPP_ACCESS_TOKEN=token-permanente-do-usuario-de-sistema
# WHATSAPP_APP_SECRET=chave-secreta-do-app-meta
# WHATSAPP_VERIFY_TOKEN=uma-frase-secreta-que-voce-inventa
# GRAPH_API_VERSION=v26.0
# ALLOWED_ORIGINS=https://www.bravusmidia.com.br,http://localhost:5173
